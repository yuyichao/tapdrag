# Manages the tapdrag LaunchAgent. Run at install time and by the `uninstall`
# target. ACTION is one of: stop, start, uninstall.

set(LABEL "@TAPDRAG_LABEL@")
set(BIN "@TAPDRAG_BIN@")
set(PLIST "@TAPDRAG_PLIST@")

# Staged install (DESTDIR set): only clear the staged binary, leave launchd alone.
if(NOT "$ENV{DESTDIR}" STREQUAL "")
  if(ACTION STREQUAL "stop")
    file(REMOVE "$ENV{DESTDIR}${BIN}")
  endif()
  return()
endif()

execute_process(COMMAND id -u OUTPUT_VARIABLE uid OUTPUT_STRIP_TRAILING_WHITESPACE)
set(domain "gui/${uid}")

if(ACTION STREQUAL "stop" OR ACTION STREQUAL "uninstall")
  execute_process(COMMAND launchctl bootout "${domain}/${LABEL}"
    RESULT_VARIABLE ignored OUTPUT_QUIET ERROR_QUIET)
  # Remove the old binary first so the new one gets a new file. Overwriting a
  # signed binary in place can make macOS kill the new one when it launches.
  file(REMOVE "${BIN}")
endif()

if(ACTION STREQUAL "uninstall")
  file(REMOVE "${PLIST}")
  message(STATUS "Removed ${BIN} and ${PLIST}")
elseif(ACTION STREQUAL "start")
  # bootout finishes asynchronously, so retry briefly.
  foreach(attempt RANGE 5)
    execute_process(COMMAND launchctl bootstrap "${domain}" "${PLIST}"
      RESULT_VARIABLE rv OUTPUT_QUIET ERROR_VARIABLE err)
    if(rv EQUAL 0)
      break()
    endif()
    execute_process(COMMAND sleep 1)
  endforeach()
  if(rv EQUAL 0)
    message(STATUS "Started ${LABEL}. Allow ${BIN} under System Settings > "
      "Privacy & Security > Accessibility; it waits until you do. Log: @TAPDRAG_LOG@")
  else()
    message(WARNING "launchctl bootstrap failed (${rv}): ${err}")
  endif()
endif()
